# ============ Base de datos (Supabase PostgreSQL - pooler) ============
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Puerto (Render lo inyecta automáticamente; déjalo solo como referencia local)
PORT=8080

# ============ Seguridad ============
# Genera uno con: openssl rand -hex 32
JWT_SECRET=<CAMBIA_ESTE_SECRETO>
# 720 horas = 30 días (sesión persistente)
JWT_EXPIRATION_HOURS=720

# Orígenes permitidos por CORS (separados por coma). Incluye tu dominio de Vercel.
CORS_ORIGINS=http://localhost:3000,https://<TU-APP>.vercel.app
